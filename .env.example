TELEGRAM_BOT_TOKEN=
TARGET_CHAT_ID=
BOT_USERNAME=

# Admin (опційно - для сповіщень про помилки експорту в Google Sheets)
ADMIN_USER_ID=
# Декілька адмінів (опційно): через кому/пробіл/;
ADMIN_USER_IDS=
# Альтернатива через usernames (опційно): @user1,@user2
ADMIN_USERNAMES=

NOVAPOSHTA_API_KEY=
DATABASE_URL=
# Опційно: максимум з'єднань у пулі PostgreSQL (за замовчуванням 10)
# DB_POOL_MAX=10

# Міні-додаток (форма заявки всередині Telegram). Без WEBAPP_URL форма вимкнена.
# Публічна https-адреса цього ж сервісу (Railway → Settings → Networking → Generate Domain)
WEBAPP_URL=
# Порт веб-сервера. Railway сам передає PORT; локально можна задати WEBAPP_PORT (за замовчуванням 8080)
# WEBAPP_PORT=8080

# Нагадування логістам у робочій групі про заявки, термін яких спливає
# REMINDERS_ENABLED=1
# Час щоденного нагадування за Києвом
REMINDER_TIME=16:00
# За скільки днів до кінцевої дати нагадувати (один раз). Заявки, створені в день нагадування
# або пізніше (наприклад, сьогодні на завтра), не нагадуються
# REMINDER_DAYS_BEFORE=2
# REMINDER_MAX_PER_RUN=30
# Хто може натискати «Виконано / Перенести / Скасовано». Якщо обидва порожні — будь-хто з групи
LOGIST_USER_IDS=
LOGIST_USERNAMES=

# Google Sheets інтеграція (рекомендовано):
# Railway/Production: скопіювати ВЕСЬ вміст JSON файлу в цю змінну (одним рядком)
GOOGLE_CREDENTIALS_JSON=

# Локальний fallback (опційно):
# GOOGLE_CREDENTIALS_FILE=your-service-account-file.json

GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_WORKSHEET_NAME=ЗАЯВКА

# Опційно: шлях до TTF-шрифту для PNG-експорту зведення (щоб коректно показувалась кирилиця)
# SUMMARY_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Railway (опційно, якщо не використовуєте nixpacks.toml):
# NIXPACKS_APT_PACKAGES=fonts-dejavu-core fonts-noto-core fonts-noto-cjk
# Альтернативний шлях для Noto Sans:
# SUMMARY_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf
